{
  "expo": {
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3635933757449986~7677902351",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow FlexiWalls to access your photos.",
          "savePhotosPermission": "Allow FlexiWalls to save wallpapers to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-video",
      "expo-sqlite",
      "expo-splash-screen"
    ],
    "name": "FlexiWalls",
    "slug": "flexiwalls",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flexiwalls",
    "android": {
      "package": "com.flexiwalls.app",
      "permissions": [
        "SET_WALLPAPER"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0819"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "extra": {
      "appName": "FlexiWalls",
      "eas": {
        "projectId": "06448efd-a8b5-4248-9695-13dd5b6428a9"
      }
    }
  }
}
